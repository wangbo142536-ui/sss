flowchart TB
  title["海事综合服务平台<br/>面向地方政府与海运市场，覆盖代理、采购、运输、船员、金融、海关、边检、税务、监管、船舶动态与 AI 数据协同"]

  subgraph L1["01 生态接入层"]
    gov["政府侧<br/>产业运行、补贴政策、市场监管、政策协同"]
    portReg["口岸监管端<br/>海关、边检、海事、港航、市场监管"]
    agent["船代企业<br/>船舶代理、采购委托、服务协调、单证协同"]
    supplier["供货商企业<br/>报价、备货、供船、QC、QA、回款"]
    serviceProvider["运输/船员/港口服务商<br/>驳船、交通艇、登轮、维修、港口作业"]
    financeEco["金融/征信/税务生态<br/>银行、征信、保险、支付、票税服务"]
    dataAi["三方数据和 AI 服务<br/>AIS、气象、电子签章、OCR/大模型"]
  end

  subgraph L2["02 门户协同入口层"]
    govPortal["政府治理门户<br/>驾驶舱、产业分析、补贴管理、政策发放、风险态势"]
    portPortal["口岸监管门户<br/>海关、边检、海事、港航、税务协同"]
    agentPortal["代理服务门户<br/>船舶服务申请、采购、单证、费用归档"]
    providerPortal["市场服务商门户<br/>供货、运输、船员、港口作业、QC/QA"]
    financePortal["金融征信税务门户<br/>授信、征信、放款、票税核验、对账"]
    apiGateway["开放接口/API 网关<br/>三方接入、数据交换、回调"]
  end

  subgraph L3["03 海事业务应用层"]
    procurementService["采购服务<br/>物料/伙食清单导入、询价比价、下单、结算归档"]
    crewService["船员服务<br/>登轮、下船、接送、住宿、体检、边检协同"]
    transportService["驳船服务<br/>锚地配送、交通艇、航线调度、签收、异常上报"]
    customsService["海关服务<br/>报关报备、船供物资合规、通关单证、核验回执"]
    borderService["边检服务<br/>人员申报、登轮许可、出入境核验、联检协同"]
    maritimeService["海事服务<br/>船舶报备、航行通告、海事协同、异常处置"]
    portShippingService["港航服务<br/>作业许可、作业计划、白名单"]
    supervisionService["监管服务<br/>企业资质、服务质量、投诉处置、异常事件、合规留痕"]
    financeService["金融服务<br/>供应链金融、预付、融资、授信、征信、还款"]
    taxService["税务服务<br/>发票、票税合规、纳税信用、税务核验"]
    weatherService["气象服务<br/>气象潮汐、锚地窗口、靠离泊预警"]
    vesselDynamicService["船舶动态服务<br/>AIS 船期、船舶动态、靠离泊状态"]
  end

  subgraph L4["04 中台能力层"]
    standard["标准主数据<br/>IMPA/MSG、服务目录、港口、单位、币种、状态字典"]
    match["大模型 SKU 匹配<br/>标准编码校验、名称规格归一、异常复核"]
    pricing["报价价格引擎<br/>多单位价格、利润率、汇率、供应商小计"]
    workflow["流程状态引擎<br/>申请、审批、订单、履约、联检、归档"]
    fileDoc["文件单证中心<br/>模板、图片、资质、发票、报关/边检/税务单证"]
    risk["征信风控授信<br/>订单真实性、企业资质、征信、税务、履约记录"]
  end

  subgraph L5["05 数据基座层"]
    masterData["主数据<br/>企业、用户、供应商、港口"]
    skuData["商品与标准库数据<br/>IMPA、伙食品类、SKU、单位等"]
    tradeData["交易数据<br/>需求、询价、报价、比价、订单"]
    serviceData["业务数据<br/>船员、驳船、执法等"]
    financeData["金融/征信/补贴数据<br/>融资、放款、还款、补贴、征信"]
    externalData["外部数据<br/>海关、边检、海事、港航、气象等"]
  end

  subgraph L6["06 技术基础设施层"]
    frontend["前端应用<br/>Vue 3 + TypeScript + Vite"]
    backend["后端服务<br/>Java + Spring Boot 模块化单体"]
    db["数据库<br/>MySQL 8.0"]
    cache["缓存与会话<br/>Redis / Token"]
    storage["文件存储<br/>模板、图片、资质、归档"]
    integration["集成与模型服务<br/>API、Webhook、模型网关"]
    security["安全与运维<br/>认证、权限、日志、备份、监控"]
  end

